const ci = require('miniprogram-ci');
const fs = require('fs');
const path = require('path');
const axios = require('axios');
const QRCode = require('qrcode');

// ===================== 环境变量（从 GitHub Secrets 读取）=====================
const APPID = process.env.WX_APPID;
const PRIVATE_KEY = process.env.WX_PRIVATE_KEY;
const WECOM_WEBHOOK = process.env.WECOM_WEBHOOK;
const BRANCH = process.env.GITHUB_REF_NAME || 'unknown';
const COMMIT_MSG = process.env.GITHUB_COMMIT_MSG || '自动构建';

// 发布配置
const PROJECT_PATH = path.resolve(__dirname, '../dist; // 编译后目录（taro）
// const PROJECT_PATH = path.resolve(__dirname, '../dist/build/mp-weixin'); // 编译后目录（UniApp默认）
const VERSION = '1.0.0';
const DESC = `${BRANCH} ${COMMIT_MSG}`;

(async () => {
  try {
    console.log('=== 微信小程序 CI 自动发布开始 ===');
    console.log('分支:', BRANCH);
    console.log('描述:', DESC);

    // 1. 写入临时私钥文件
    const keyPath = path.resolve(__dirname, '../private.key');
    fs.writeFileSync(keyPath, PRIVATE_KEY, 'utf8');

    // 2. 初始化小程序项目
    const project = new ci.Project({
      appid: APPID,
      type: 'miniProgram',
      projectPath: PROJECT_PATH,
      privateKeyPath: keyPath,
      ignores: ['node_modules/**/*'],
    });

    // 3. 上传代码到微信后台
    const uploadResult = await ci.upload({
      project,
      version: VERSION,
      desc: DESC,
      setting: { es6: true, minify: true },
      onProgressUpdate: undefined,
    });

    console.log('✅ 上传成功:', uploadResult);

    // 4. 生成预览二维码（体验版链接）
    const qrUrl = `https://mp.weixin.qq.com/a/${APPID}`;
    const qrBase64 = await QRCode.toDataURL(qrUrl);
    const base64Data = qrBase64.replace(/^data:image\/png;base64,/, '');

    // 5. 推送企业微信通知
    await axios.post(WECOM_WEBHOOK, {
      msgtype: 'mpnews',
      mpnews: {
        articles: [
          {
            title: '✅ 小程序自动构建成功',
            digest: `分支：${BRANCH}\n版本：${VERSION}\n说明：${DESC}`,
            thumb_media_id: '',
            content: `<img src="${qrBase64}"><br>扫码体验最新版本`,
          },
        ],
      },
    });

    console.log('✅ 企业微信推送完成');
    fs.unlinkSync(keyPath);
  } catch (error) {
    console.error('❌ 发布失败:', error);
    // 出错也推送到企微
    await axios.post(WECOM_WEBHOOK, {
      msgtype: 'text',
      text: { content: `❌ 小程序构建失败\n分支：${BRANCH}\n错误：${error.message}` },
    });
    process.exit(1);
  }
})();