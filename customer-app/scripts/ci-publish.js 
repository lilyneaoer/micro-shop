const ci = require('miniprogram-ci');
const fs = require('fs');
const axios = require('axios');
const QRCode = require('qrcode');

// 从环境变量读取配置
const {
  WX_APPID,
  WX_PRIVATE_KEY,
  WECOM_WEBHOOK,
  GITEE_REF,         // Gitee 自动提供
  GITEE_COMMIT_MSG   // Gitee 自动提供
} = process.env;

// 项目配置
const projectConfig = {
  appid: WX_APPID,
  type: 'miniProgram',
  projectPath: '../dist/', // taro 编译后目录
  // projectPath: './dist/build/mp-weixin', // UniApp 编译后目录
  privateKey: WX_PRIVATE_KEY,
  ignores: ['node_modules/**/*'],
};

// 上传版本描述
const version = '1.0.0';
const desc = `${GITEE_REF} | ${GITEE_COMMIT_MSG || '自动构建'}`;

(async () => {
  try {
    console.log('✅ 开始上传微信小程序...');
    const project = new ci.Project(projectConfig);

    // 上传
    const uploadResult = await ci.upload({
      project,
      version,
      desc,
      setting: { es6: true, minify: true },
      onProgressUpdate: console.log,
    });

    console.log('✅ 上传成功:', uploadResult);

    // 生成预览二维码
    const qrCodeUrl = `https://open.weixin.qq.com/showqr?appid=${WX_APPID}&path=`;
    const qrBase64 = await QRCode.toDataURL(qrCodeUrl);

    // 推送到企业微信
    if (WECOM_WEBHOOK) {
      await axios.post(WECOM_WEBHOOK, {
        msgtype: 'news',
        news: {
          articles: [
            {
              title: `小程序自动构建完成`,
              description: `版本：${version}\n分支：${GITEE_REF}\n说明：${desc}`,
              url: qrCodeUrl,
              picurl: qrBase64,
            },
          ],
        },
      });
      console.log('✅ 企业微信推送成功');
    }
  } catch (err) {
    console.error('❌ 构建失败：', err);
    process.exit(1);
  }
})();